<%- include('../partial/header.ejs') %> <%- include('../partial/nav.ejs') %> <%
if(errorMessage && errorMessage.length > 0) { %>
<div class="alert alert-danger alert-dismissible fade show" role="alert">
  <strong><%= errorMessage %></strong>
  <button type="button" class="close" data-dismiss="alert" aria-label="Close">
    <span aria-hidden="true">&times;</span>
  </button>
</div>
<% } %> <% if(successMessage && successMessage.length > 0) { %>
<div class="alert alert-success alert-dismissible fade show" role="alert">
  <strong><%= successMessage %></strong>
  <button type="button" class="close" data-dismiss="alert" aria-label="Close">
    <span aria-hidden="true">&times;</span>
  </button>
</div>
<% } %> <%- include('../partial/cartOrdersSubNav.ejs') %>
<table class="table table-striped d-table w-80 justify-content-center mx-auto">
  <thead class="bg-info text-white">
    <tr>
      <th>Product Name</th>
      <th>Price</th>
      <th>Action</th>
    </tr>
  </thead>
  <% let totalPrice = 0; %>
  <% if (cart && cart.length > 0) { %>
  <tbody class="alert-info">
    <% cart.forEach(item => { %>
    <tr>
      <td><%= item.product.title %></td>
      <td>
        <% if(item.product.type === 'redeem') { %>
        <%= item.product.price.toFixed(2) %> JOD
        <% } else { %>
          <span class="badge bg-muted">Coupon</span>
        <% } %>
      </td>
        
      <% totalPrice += item.product.price*item.qty; %>
      <td>
        <form action="/shop/cart/remove/<%= item.product._id %>" method="POST" style="display:inline;">
          <% if(item.qty === 1) { %>
          <button type="submit" class="fa-solid fa-trash btn btn-muted"></button>
          <% } else { %>
          <button type="submit" class="fa-solid fa-minus btn btn-muted"></button>
          <% } %>
        </form>
        <span style="background-color: rgba(127, 142, 208, 0.396); padding: 10px;"> <%= item.qty %></span>
        <form action="/shop/buy-now/<%= item.product._id %>" style=" display: inline;" method="get">
          <button type="submit" class="fa-solid fa-plus btn"></button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
  <tfoot >
    <tr class="alert-success text-dark">
      <td  class="text-right text-center ">Items :</td>
      <td colspan="2" class="text-left"><%= cart ? cart.length : 0 %></td>
    </tr>
    <tr class="alert-success text-dark">
      <td  class="text-right text-center">Total:</td>
      <td colspan="2" class="text-left">$<%= totalPrice.toFixed(2) %></td>
    </tr>
    <% if(user.payment){ %>
      <tr class="alert-success text-dark">
        <td class="text-right text-center">Pay with card end in:</td>
        <td class="text-left">xxxxxxxxx<%= user.payment.card_no.slice(-4) %></td>
        <td class="text-left">
          <button type="button" class="btn btn-primary" onclick="showPaymentForm()">Change</button>
        </td>
      </tr>
      <tr>
        <td colspan="3" class="text-center">
          <form action="/shop/cart/checkout" method="POST">
            <input type="hidden" name="totalPrice" value="<%= totalPrice %>">
            <button type="submit" class="btn btn-success" id="checkoutButton">Pay Now</button>
          </form>
      </td>
      </tr>
    <% } else {%>
    <tr>
      <td colspan="3" class="text-center">
          <button type="submit" class="btn btn-success" onclick="showPaymentForm()" id="checkoutButton">Checkout</button>
      </td>
    </tr>
    <% } %>
    <script>
      function showPaymentForm() {
        document.getElementById('paymentForm').hidden = false;
        document.getElementById('paymentForm').scrollIntoView({ behavior: 'smooth' });
        document.getElementById('checkoutButton').hidden = true;
      }
    </script>
  </tfoot>
  <% } else { %>
  <tr class="alert-info">
    <td colspan="3" class="text-center">Your cart is empty.</td>
  </tr>
  <% } %>
</table>

<!-- CARD PAYMENT FORM -->
<div class="container mt-5 w-50" hidden="true" id="paymentForm">
  <form action="/shop/cart/checkout" method="POST">
    <input type="hidden" name="totalPrice" value="<%= totalPrice %>">
    <label for="cardnumber">Card Number:</label>
    <input type="text" id="cardnumber" name="cardnumber" class="form-control" placeholder="Enter card number" required><br>
    <label for="expirydate">Expiry Date:</label>
    <input type="text" id="expirydate" name="expirydate" class="form-control" placeholder="MM/YY" required><br>
    <label for="cvv">CVV:</label>
    <input type="text" id="cvv" name="cvv" class="form-control" placeholder="Enter CVV" required><br>
    <input type="checkbox" id="savecard" name="savecard" class="form-check-input"><span>Save Payment Info</span>
    <div class="justify-content-center text-center m-3">
    <button type="submit" class="btn btn-primary">Pay Now</button>
    <button class="btn btn-secondary" onclick="cancelPayment()"> Cancel </button>
    <script>
      function cancelPayment() {
        document.getElementById('paymentForm').hidden = true;
        document.getElementById('checkoutButton').hidden = false;
      }
    </script>
    </div>
  </form>
</div>
<!-- End of Card Payment Form -->

<%- include('../partial/footer.ejs') %>
